:name: ModbusSlave-nRF52840-Test

$bin = @../build_renode/zephyr/zephyr.elf
$uart_log = @UART_LOG_PLACEHOLDER

mach create
machine LoadPlatformDescription @platforms/boards/nrf52840dk_nrf52840.repl
sysbus LoadELF $bin

sysbus.uart0 CreateFileBackend $uart_log true

emulation RunFor "00:00:10"

quit
